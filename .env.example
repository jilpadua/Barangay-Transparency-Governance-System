# Application
APP_URL=http://localhost:3000
AUTH_SECRET=generate-a-long-random-secret-here
AUTH_TRUST_HOST=true

# Database
DATABASE_URL=postgresql://btgs:btgs_dev_password@localhost:5432/btgs?schema=public

# Object storage (local | s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
STORAGE_ENDPOINT=

# Blockchain (EVM-compatible; unused until Phase 5)
BLOCKCHAIN_NETWORK=localhost
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_ENABLED=false

# Email (optional)
EMAIL_PROVIDER=
EMAIL_FROM=noreply@barangay.example.gov.ph

# SMS (optional)
OPTIONAL_SMS_PROVIDER=
