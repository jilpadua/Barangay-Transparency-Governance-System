// Barangay Transparency & Governance System — Prisma schema
// Demo data must be clearly marked; never treat seed records as official government data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum PublicationStatus {
  DRAFT
  FOR_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum ProjectStatus {
  PLANNING
  PROCUREMENT
  APPROVED
  ONGOING
  DELAYED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum FeedbackType {
  SUGGESTION
  COMPLAINT
  PROJECT_CONCERN
  SERVICE_FEEDBACK
  INFORMATION_REQUEST
  OTHER
}

enum FeedbackStatus {
  RECEIVED
  UNDER_REVIEW
  ASSIGNED
  ACTION_TAKEN
  RESOLVED
  CLOSED
}

enum BlockchainProofStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
  MISMATCH
}

enum OfficialBody {
  BARANGAY
  SK
}

enum DocumentVisibility {
  PUBLIC
  INTERNAL
  RESTRICTED
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  POSTPONED
}

enum LegalInstrumentStatus {
  DRAFT
  PENDING
  APPROVED
  ENACTED
  REPEALED
  ARCHIVED
}

// ─── Auth & RBAC ─────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  username       String?   @unique
  name           String?
  passwordHash   String
  image          String?
  emailVerified  DateTime?
  isActive       Boolean   @default(true)
  mfaEnabled     Boolean   @default(false)
  mfaSecret      String?
  barangayId     String?
  barangay       Barangay? @relation(fields: [barangayId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  userRoles  UserRole[]
  auditLogs  AuditLog[]
  feedbackAssigned Feedback[] @relation("FeedbackAssignee")

  @@index([barangayId])
  @@index([isActive])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  module      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([module])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// ─── Barangay ────────────────────────────────────────────────────────────────

model Barangay {
  id           String   @id @default(cuid())
  name         String
  municipality String
  province     String
  address      String?
  contactEmail String?
  contactPhone String?
  officeHours  String?
  history      String?  @db.Text
  mission      String?  @db.Text
  vision       String?  @db.Text
  generalInfo  String?  @db.Text
  mapEmbedUrl  String?
  logoUrl      String?
  tagline      String?
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users           User[]
  officials       Official[]
  committees      Committee[]
  budgets         Budget[]
  expenses        Expense[]
  fundSources     FundSource[]
  projects        Project[]
  procurements    Procurement[]
  suppliers       Supplier[]
  documents       Document[]
  meetings        Meeting[]
  resolutions     Resolution[]
  ordinances      Ordinance[]
  events          Event[]
  announcements   Announcement[]
  accomplishments Accomplishment[]
  feedbacks       Feedback[]
  auditLogs       AuditLog[]
  blockchainProofs BlockchainProof[]
}

// ─── Officials ───────────────────────────────────────────────────────────────

model Committee {
  id         String   @id @default(cuid())
  barangayId String
  name       String
  body       OfficialBody @default(BARANGAY)
  description String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  barangay  Barangay  @relation(fields: [barangayId], references: [id], onDelete: Cascade)
  officials Official[]

  @@index([barangayId])
}

model Official {
  id              String       @id @default(cuid())
  barangayId      String
  committeeId     String?
  body            OfficialBody @default(BARANGAY)
  firstName       String
  lastName        String
  middleName      String?
  position        String
  photoUrl        String?
  publicBio       String?      @db.Text
  publicEmail     String?
  termStart       DateTime?
  termEnd         DateTime?
  isActive        Boolean      @default(true)
  isDemo          Boolean      @default(false)
  publicationStatus PublicationStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  barangay   Barangay   @relation(fields: [barangayId], references: [id], onDelete: Cascade)
  committee  Committee? @relation(fields: [committeeId], references: [id])
  attendances Attendance[]
  projectsResponsible Project[] @relation("ProjectResponsible")

  @@index([barangayId])
  @@index([body])
  @@index([publicationStatus])
  @@index([publishedAt])
}

// ─── Finance ─────────────────────────────────────────────────────────────────

model FundSource {
  id         String   @id @default(cuid())
  barangayId String
  name       String
  code       String?
  description String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  barangay Barangay @relation(fields: [barangayId], references: [id], onDelete: Cascade)
  budgets  Budget[]
  expenses Expense[]
  projects Project[]

  @@index([barangayId])
}

model Budget {
  id               String            @id @default(cuid())
  barangayId       String
  fundSourceId     String?
  fiscalYear       Int
  category         String
  title            String
  approvedAmount   Decimal           @db.Decimal(18, 2)
  description      String?           @db.Text
  documentId       String?
  publicationStatus PublicationStatus @default(DRAFT)
  publishedAt      DateTime?
  isDemo           Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  barangay    Barangay           @relation(fields: [barangayId], references: [id], onDelete: Cascade)
  fundSource  FundSource?        @relation(fields: [fundSourceId], references: [id])
  allocations BudgetAllocation[]
  expenses    Expense[]

  @@index([barangayId])
  @@index([fiscalYear])
  @@index([category])
  @@index([publicationStatus])
  @@index([publishedAt])
}

model BudgetAllocation {
  id          String   @id @default(cuid())
  budgetId    String
  lineItem    String
  amount      Decimal  @db.Decimal(18, 2)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
}

model Expense {
  id               String            @id @default(cuid())
  barangayId       String
  budgetId         String?
  fundSourceId     String?
  projectId        String?
  expenseDate      DateTime
  referenceNumber  String
  amount           Decimal           @db.Decimal(18, 2)
  purpose          String
  payee            String?
  supplierId       String?
  publicationStatus PublicationStatus @default(DRAFT)
  publishedAt      DateTime?
  isDemo           Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  barangay   Barangay    @relation(fields: [barangayId], references: [id], onDelete: Cascade)
  budget     Budget?     @relation(fields: [budgetId], references: [id])
  fundSource FundSource? @relation(fields: [fundSourceId], references: [id])
  project    Project?    @relation(fields: [projectId], references: [id])
  supplier   Supplier?   @relation(fields: [supplierId], references: [id])

  @@index([barangayId])
  @@index([referenceNumber])
  @@index([expenseDate])
  @@index([projectId])
  @@index([publicationStatus])
  @@index([createdAt])
}

// ─── Projects & Procurement ──────────────────────────────────────────────────

model Supplier {
  id         String   @id @default(cuid())
  barangayId String
  name       String
  address    String?
  contact    String?
  isDemo     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  barangay     Barangay      @relation(fields: [barangayId], references: [id], onDelete: Cascade)
  projects     Project[]
  procurements Procurement[]
  expenses     Expense[]

  @@index([barangayId])
}

model Project {
  id                  String            @id @default(cuid())
  barangayId          String
  projectCode         String
  title               String
  description         String?           @db.Text
  category            String?
  location            String?
  implementingOffice  String?
  responsibleOfficialId String?
  budgetAmount        Decimal?          @db.Decimal(18, 2)
  contractAmount      Decimal?          @db.Decimal(18, 2)
  fundSourceId        String?
  supplierId          String?
  startDate           DateTime?
  targetCompletion    DateTime?
  actualCompletion    DateTime?
  status              ProjectStatus     @default(PLANNING)
  progressPercent     Int               @default(0)
  publicationStatus   PublicationStatus @default(DRAFT)
  publishedAt         DateTime?
  isDemo              Boolean           @default(false)
  isSk                Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  barangay            Barangay  @relation(fields: [barangayId], references: [id], onDelete: Cascade)
  responsibleOfficial Official? @relation("ProjectResponsible", fields: [responsibleOfficialId], references: [id])
  fundSource          FundSource? @relation(fields: [fundSourceId], references: [id])
  supplier            Supplier? @relation(fields: [supplierId], references: [id])
  updates             ProjectUpdate[]
  media               ProjectMedia[]
  procurements        Procurement[]
  expenses            Expense[]
  accomplishments     Accomplishment[]
  milestones          BlockchainMilestone[]

  @@unique([barangayId, projectCode])
  @@index([barangayId])
  @@index([status])
  @@index([publicationStatus])
  @@index([publishedAt])
  @@index([category])
  @@index([createdAt])
}

model ProjectUpdate {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  content     String   @db.Text
  progressPercent Int?
  updateDate  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([updateDate])
}

model ProjectMedia {
  id          String   @id @default(cuid())
  projectId   String
  url         String
  caption     String?
  mediaType   String   @default("image")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Procurement {
  id                 String            @id @default(cuid())
  barangayId         String
  projectId          String?
  supplierId         String?
  referenceNumber    String
  title              String
  method             String?
  approvedBudget     Decimal?          @db.Decimal(18, 2)
  contractAmount     Decimal?          @db.Decimal(18, 2)
  procurementDate    DateTime?
  awardDate          DateTime?
  status             String?
  publicationStatus  PublicationStatus @default(DRAFT)
  publishedAt        DateTime?
  isDemo             Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  barangay Barangay  @relation(fields: [barangayId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([barangayId])
  @@index([referenceNumber])
  @@index([projectId])
  @@index([publicationStatus])
  @@index([createdAt])
}

// ─── Documents ───────────────────────────────────────────────────────────────

model Document {
  id               String             @id @default(cuid())
  barangayId       String
  documentCode     String
  title            String
  description      String?            @db.Text
  category         String
  referenceNumber  String?
  publicationDate  DateTime?
  visibility       DocumentVisibility @default(PUBLIC)
  publicationStatus PublicationStatus @default(DRAFT)
  publishedAt      DateTime?
  isDemo           Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  barangay Barangay          @relation(fields: [barangayId], references: [id], onDelete: Cascade)
  versions DocumentVersion[]

  @@unique([barangayId, documentCode])
  @@index([barangayId])
  @@index([category])
  @@index([referenceNumber])
  @@index([publicationStatus])
  @@index([publishedAt])
  @@index([createdAt])
}

model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  version     String
  fileUrl     String
  fileName    String
  fileSize    Int?
  mimeType    String?
  notes       String?
  isCurrent   Boolean  @default(true)
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([isCurrent])
}

// ─── Meetings ────────────────────────────────────────────────────────────────

model Meeting {
  id          String        @id @default(cuid())
  barangayId  String
  meetingType String
  title       String
  meetingDate DateTime
  startTime   String?
  endTime     String?
  location    String?
  agenda      String?       @db.Text
  minutes     String?       @db.Text
  status      MeetingStatus @default(SCHEDULED)
  publicationStatus PublicationStatus @default(DRAFT)
  publishedAt DateTime?
  isDemo      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  barangay    Barangay     @relation(fields: [barangayId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@index([barangayId])
  @@index([meetingDate])
  @@index([status])
  @@index([publicationStatus])
  @@index([createdAt])
}

model Attendance {
  id         String           @id @default(cuid())
  meetingId  String
  officialId String
  status     AttendanceStatus
  remarks    String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  meeting  Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  official Official @relation(fields: [officialId], references: [id], onDelete: Cascade)

  @@unique([meetingId, officialId])
  @@index([meetingId])
  @@index([officialId])
  @@index([status])
}

// ─── Resolutions & Ordinances ────────────────────────────────────────────────

model Resolution {
  id               String                @id @default(cuid())
  barangayId       String
  referenceNumber  String
  title            String
  type             String?
  subject          String?
  authoringBody    String?
  resolutionDate   DateTime?
  description      String?               @db.Text
  documentUrl      String?
  version          String                @default("1.0")
  status           LegalInstrumentStatus @default(DRAFT)
  publicationStatus PublicationStatus    @default(DRAFT)
  publishedAt      DateTime?
  isDemo           Boolean               @default(false)
  isSk             Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  barangay Barangay @relation(fields: [barangayId], references: [id], onDelete: Cascade)

  @@index([barangayId])
  @@index([referenceNumber])
  @@index([status])
  @@index([publicationStatus])
  @@index([publishedAt])
  @@index([createdAt])
}

model Ordinance {
  id               String                @id @default(cuid())
  barangayId       String
  referenceNumber  String
  title            String
  type             String?
  subject          String?
  authoringBody    String?
  ordinanceDate    DateTime?
  description      String?               @db.Text
  documentUrl      String?
  version          String                @default("1.0")
  status           LegalInstrumentStatus @default(DRAFT)
  publicationStatus PublicationStatus    @default(DRAFT)
  publishedAt      DateTime?
  isDemo           Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  barangay Barangay @relation(fields: [barangayId], references: [id], onDelete: Cascade)

  @@index([barangayId])
  @@index([referenceNumber])
  @@index([status])
  @@index([publicationStatus])
  @@index([publishedAt])
  @@index([createdAt])
}

// ─── Events & Announcements ──────────────────────────────────────────────────

model Event {
  id              String            @id @default(cuid())
  barangayId      String
  title           String
  description     String?           @db.Text
  eventDate       DateTime
  startTime       String?
  endTime         String?
  location        String?
  organizer       String?
  targetAudience  String?
  registrationInfo String?          @db.Text
  results         String?           @db.Text
  photoUrls       String[]
  publicationStatus PublicationStatus @default(DRAFT)
  publishedAt     DateTime?
  isDemo          Boolean           @default(false)
  isSk            Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  barangay        Barangay         @relation(fields: [barangayId], references: [id], onDelete: Cascade)
  accomplishments Accomplishment[]

  @@index([barangayId])
  @@index([eventDate])
  @@index([publicationStatus])
  @@index([publishedAt])
  @@index([createdAt])
}

model Announcement {
  id          String            @id @default(cuid())
  barangayId  String
  title       String
  content     String            @db.Text
  publishDate DateTime?
  expireDate  DateTime?
  featured    Boolean           @default(false)
  attachmentUrls String[]
  publicationStatus PublicationStatus @default(DRAFT)
  publishedAt DateTime?
  isDemo      Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  barangay Barangay @relation(fields: [barangayId], references: [id], onDelete: Cascade)

  @@index([barangayId])
  @@index([featured])
  @@index([publicationStatus])
  @@index([publishedAt])
  @@index([createdAt])
}

// ─── Accomplishments ─────────────────────────────────────────────────────────

model Accomplishment {
  id          String            @id @default(cuid())
  barangayId  String
  projectId   String?
  eventId     String?
  title       String
  reportType  String
  periodLabel String?
  description String?           @db.Text
  documentUrl String?
  publicationStatus PublicationStatus @default(DRAFT)
  publishedAt DateTime?
  isDemo      Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  barangay Barangay @relation(fields: [barangayId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id])
  event    Event?   @relation(fields: [eventId], references: [id])

  @@index([barangayId])
  @@index([projectId])
  @@index([publicationStatus])
  @@index([publishedAt])
  @@index([createdAt])
}

// ─── Feedback ────────────────────────────────────────────────────────────────

model Feedback {
  id              String         @id @default(cuid())
  barangayId      String
  trackingNumber  String         @unique
  type            FeedbackType
  subject         String
  message         String         @db.Text
  // Personal contact kept internal — not exposed on public APIs
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  status          FeedbackStatus @default(RECEIVED)
  assigneeId      String?
  isDemo          Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  barangay      Barangay                 @relation(fields: [barangayId], references: [id], onDelete: Cascade)
  assignee      User?                    @relation("FeedbackAssignee", fields: [assigneeId], references: [id])
  statusHistory FeedbackStatusHistory[]

  @@index([barangayId])
  @@index([trackingNumber])
  @@index([status])
  @@index([createdAt])
}

model FeedbackStatusHistory {
  id         String         @id @default(cuid())
  feedbackId String
  status     FeedbackStatus
  notes      String?        @db.Text
  // Public-safe notes only for resident tracking view
  publicNote String?
  createdAt  DateTime       @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
  @@index([createdAt])
}

// ─── Audit ───────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  barangayId String?
  userId     String?
  userEmail  String?
  userRole   String?
  action     String
  module     String
  recordId   String?
  fieldName  String?
  oldValue   String?  @db.Text
  newValue   String?  @db.Text
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  barangay Barangay? @relation(fields: [barangayId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])

  @@index([barangayId])
  @@index([userId])
  @@index([module])
  @@index([recordId])
  @@index([createdAt])
  @@index([action])
}

// ─── Blockchain ──────────────────────────────────────────────────────────────

model BlockchainProof {
  id              String                @id @default(cuid())
  barangayId      String?
  recordId        String
  recordType      String
  version         String                @default("1.0")
  contentHash     String
  network         String?
  transactionHash String?
  blockNumber     Int?
  anchoredAt      DateTime?
  status          BlockchainProofStatus @default(PENDING)
  errorMessage    String?               @db.Text
  retryCount      Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  barangay Barangay? @relation(fields: [barangayId], references: [id])

  @@index([recordId])
  @@index([recordType])
  @@index([status])
  @@index([transactionHash])
  @@index([createdAt])
  @@index([barangayId])
}

model BlockchainMilestone {
  id              String                @id @default(cuid())
  projectId       String
  milestoneKey    String
  title           String
  recordId        String?
  supportingDocUrl String?
  contentHash     String?
  transactionHash String?
  status          BlockchainProofStatus @default(PENDING)
  occurredAt      DateTime              @default(now())
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([occurredAt])
}
