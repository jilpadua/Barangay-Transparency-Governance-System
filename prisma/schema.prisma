// Barangay Transparency & Governance System — Prisma schema
// Demo data must be clearly marked; never treat seed records as official government data.
// Domain models live in enums/ and models/ subdirectories (multi-file schema).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
